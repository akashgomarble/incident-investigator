   "kind": "finding",
   "id": "F5",
   "agent": "baseline",
   "task": null,
   "verified": true,
   "statement": "Three OOMKills occurred, one per ~24h cycle, each right after memory reached ~95-98%: 2026-03-21T22:59:50, 2026-03-22T21:59:47, 2026-03-23T19:59:21 (all 'OOMKilled (exit code 137)')."
  },
