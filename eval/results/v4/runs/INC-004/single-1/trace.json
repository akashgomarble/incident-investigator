   "kind": "finding",
   "id": "F10",
   "agent": "baseline",
   "task": null,
   "verified": true,
   "statement": "notification-service consumer_lag was normal (~40-90) through 19:30 on 03-23 and only spiked to 6082.94 avg / 18137.93 max at 19:45-20:15, AFTER memory had already been ~94-98% and the container was thrashing prior to the 19:59 OOM."
